GOOGLE_API_KEY=your-google-api-key
# Optional extra Google keys. Numbered keys are used as a key pool.
# GOOGLE_API_KEY1=your-second-google-api-key
# GOOGLE_API_KEY2=your-third-google-api-key

GROQ_API_KEY=your-groq-api-key
# Optional extra Groq keys. Numbered keys are used as a key pool.
# GROQ_API_KEY1=your-second-groq-api-key
# GROQ_API_KEY2=your-third-groq-api-key

OPENROUTER_API_KEY=your-openrouter-api-key
# Optional extra OpenRouter keys. Numbered keys are used as a key pool.
# OPENROUTER_API_KEY1=your-second-openrouter-api-key
# OPENROUTER_API_KEY2=your-third-openrouter-api-key
# Optional OpenRouter attribution headers.
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=Deep Research Agent

TAVILY_API_KEY=your-tavily-api-key
# Optional extra Tavily keys. Numbered keys are rotated for search acquisition.
# TAVILY_API_KEY1=your-second-tavily-api-key
# TAVILY_API_KEY2=your-third-tavily-api-key
# TAVILY_API_KEY_3=your-fourth-tavily-api-key
# TAVILY_API_KEYS=your-fifth-tavily-api-key,your-sixth-tavily-api-key
# Other env names containing TAVILY, API, and KEY are also discovered.
# TAVILY_SEARCH_API_KEY=your-extra-tavily-api-key

# Optional provider/model overrides.
DEEP_RESEARCH_PROVIDER=auto
# DEEP_RESEARCH_PROVIDER=hybrid
# DEEP_RESEARCH_PROVIDER=ollama
# DEEP_RESEARCH_PROVIDER=openrouter
# DEEP_RESEARCH_MODEL=openrouter:openrouter/free
# DEEP_RESEARCH_MODEL=groq:openai/gpt-oss-20b
# DEEP_RESEARCH_FAST_MODEL=groq:openai/gpt-oss-20b
# DEEP_RESEARCH_PLANNER_MODEL=groq:openai/gpt-oss-20b
# DEEP_RESEARCH_RESEARCHER_MODEL=groq:openai/gpt-oss-20b
# DEEP_RESEARCH_ANALYST_MODEL=groq:openai/gpt-oss-20b
# DEEP_RESEARCH_VERIFIER_MODEL=groq:openai/gpt-oss-20b
# DEEP_RESEARCH_JUDGE_MODEL=groq:openai/gpt-oss-20b
# DEEP_RESEARCH_MODEL_FALLBACKS=true
# DEEP_RESEARCH_PRECOLLECT_SOURCES=true
# DEEP_RESEARCH_PROVIDER_RETRY_ATTEMPTS=1
# DEEP_RESEARCH_PROVIDER_RETRY_MAX_WAIT_SECONDS=60
# DEEP_RESEARCH_MODEL_REQUEST_TIMEOUT_SECONDS=120
# DEEP_RESEARCH_MODEL_MAX_OUTPUT_TOKENS=8192
# DEEP_RESEARCH_MAX_FOLLOWUP_QUERIES_PER_BRANCH=12
# DEEP_RESEARCH_SCRAPE_CHAR_LIMIT=6000
# DEEP_RESEARCH_SCRAPE_TIMEOUT_MS=20000
# DEEP_RESEARCH_SCRAPE_RETRIES=2
# DEEP_RESEARCH_TOOL_EXCERPT_CHAR_LIMIT=900
